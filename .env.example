# Supabase project URL and PUBLISHABLE key (safe for the app bundle).
# Find them in Supabase → Project Settings → API Keys.
# NEVER put the service_role / secret key here — anything prefixed EXPO_PUBLIC_ ships inside the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
